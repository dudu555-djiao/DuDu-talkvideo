# Copy to .env on YOUR computer. Never upload .env or paste keys in public chats.
# Choose ONE authentication method. Empty values are not valid credentials.

# Method A: Volcengine TTS API key
VOLC_TTS_API_KEY=

# Method B: App ID + Access Token
VOLC_TTS_APP_ID=
VOLC_TTS_ACCESS_TOKEN=

# Optional: absolute path to an external private .env file.
# Alternatively export DUDU_TALKVIDEO_TTS_ENV in your terminal environment.
